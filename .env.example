# Morning Shift's own writable configuration/workflow database.
DATABASE_URL=postgresql+psycopg://morning_shift:CHANGE_ME@127.0.0.1:5432/morning_shift

# Required in production. Generate a 64-character value with `openssl rand -hex 32`.
FLASK_SECRET_KEY=CHANGE_ME__64_CHARACTER_RANDOM_SECRET
FLASK_SESSION_COOKIE_SECURE=true

# Encrypted PMS source. Use a read-only role; this database must never be
# used for Morning Shift's settings or handled-state writes.
PMS_DATABASE_URL=postgresql+psycopg://morning_shift_reader:CHANGE_ME@127.0.0.1:5432/diggies_pms

# Morning Shift's recipient private key. Supply it through a secret manager
# or a systemd credential in production; do not commit it or store it in a DB.
PMS_DECRYPTION_PRIVATE_KEY='CHANGE_ME__PRIVATE_KEY_WITH_LITERAL_BACKSLASH_N_LINE_BREAKS'
PMS_DECRYPTION_KEY_ID=morning-shift-2026-01
